PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hong_tra_le_gia
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_TTL_DAYS=7
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
TRUST_PROXY=false
MAX_DELIVERY_DISTANCE_KM=4
MAX_TAKEAWAY_DISTANCE_METERS=600
DELIVERY_FEE=15000
APP_TIMEZONE=Asia/Bangkok

# Email delivery for password reset codes (use an app password, not your email login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=MAXKO F&B <your-smtp-user@example.com>

# Configure these before enabling VietQR order payments.
BANK_CODE=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=

# Configure an invoice/tax lookup provider before enabling VAT services.
TAX_LOOKUP_URL=
