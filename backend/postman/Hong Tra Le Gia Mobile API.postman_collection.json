            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nguyen Hoang Nam\",\n  \"phone\": \"0988776655\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password@123\",\n  \"role\": \"CUSTOMER\"\n}",
